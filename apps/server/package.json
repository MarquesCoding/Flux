{
  "name": "@flux/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/Main.ts",
    "build": "tsc --build",
    "start": "node dist/Main.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
