{
  "name": "@valence/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/Main.ts",
    "build": "tsc --build",
    "start": "node dist/Main.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "bundle": "esbuild src/Main.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=dist/Main.js"
  },
  "dependencies": {
    "@better-auth/api-key": "^1.7.4",
    "@better-auth/passkey": "^1.7.4",
    "@dicebear/collection": "^9.4.2",
    "@dicebear/core": "^9.4.3",
    "@hono/node-server": "^2.0.0",
    "@hono/node-ws": "^1.3.1",
    "@hono/zod-openapi": "^1.6.3",
    "@scalar/hono-api-reference": "^0.12.0",
    "@valence/contracts": "workspace:*",
    "@valence/core": "workspace:*",
    "@valence/plugin-sdk": "workspace:*",
    "better-auth": "^1.7.4",
    "drizzle-orm": "^0.45.2",
    "fflate": "^0.8.3",
    "hono": "^4.13.7",
    "mupdf": "^1.28.1",
    "node-unrar-js": "^2.0.2",
    "pg": "^8.23.0",
    "pg-boss": "^12.31.0",
    "sanitize-html": "^2.17.7",
    "sharp": "^0.35.0",
    "undici": "^8.10.2",
    "web-push": "^3.6.7",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@better-auth/utils": "0.4.2",
    "@types/pg": "^8.23.1",
    "@types/sanitize-html": "^2.16.1",
    "@types/web-push": "^3.6.4",
    "@vitest/coverage-v8": "^4.1.11",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.13",
    "vitest": "^4.1.11"
  }
}
