    "@dicebear/collection": "^9.4.2",
    "@dicebear/core": "^9.4.3",
    "@flux/contracts": "workspace:*",
    "@flux/core": "workspace:*",
    "@flux/plugin-sdk": "workspace:*",
    "@hono/node-server": "^1.13.7",
    "@hono/node-ws": "^1.3.1",
    "@hono/zod-openapi": "^1.6.0",
    "@scalar/hono-api-reference": "^0.5.165",
    "better-auth": "^1.7.1",
    "drizzle-orm": "^0.45.2",
    "fflate": "^0.8.3",
    "hono": "^4.10.0",
    "mupdf": "^1.28.0",
    "node-unrar-js": "^2.0.2",
    "pg": "^8.23.0",
    "pg-boss": "^12.27.0",
    "undici": "^8.10.0",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@better-auth/utils": "0.4.2",
    "@types/pg": "^8.21.0",
    "@types/web-push": "^3.6.4",
    "@vitest/coverage-v8": "^4.1.10",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.19.2",
    "vitest": "^4.1.10"
  }
