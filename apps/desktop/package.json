{
  "name": "@flux/desktop",
  "version": "0.0.0",
  "productName": "Flux",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "package": "electron-vite build && electron-builder",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@flux/client": "workspace:*",
    "@flux/contracts": "workspace:*",
    "@flux/screens": "workspace:*",
    "@flux/ui": "workspace:*",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.29",
    "better-auth": "^1.7.1",
    "conf": "^15.0.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query-devtools": "^5.101.4",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "electron": "github:castlabs/electron-releases#v43.2.0+wvcus",
    "electron-builder": "^26.0.12",
    "electron-vite": "^4.0.1",
    "jsdom": "^26.0.0",
    "tailwindcss": "^4.0.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "main": "dist-main/main/Main.js",
  "build": {
    "appId": "app.flux.desktop",
    "productName": "Flux",
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-main/**",
      "dist-preload/**",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.entertainment",
      "icon": "build/icon.png"
    },
    "win": {
      "icon": "build/icon.png"
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "AudioVideo"
    }
  }
}
