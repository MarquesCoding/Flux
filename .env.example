NODE_ENV=production
PORT=8420

DATABASE_URL=postgres://flux:flux@db:5432/flux

# Must be a randomly generated value of at least 32 characters.
# Generate with: openssl rand -base64 48
BETTER_AUTH_SECRET=change-me-to-a-random-value-at-least-32-chars

# The URL users actually reach this instance on.
BETTER_AUTH_URL=http://localhost:8420

# Every origin the web client is served from, comma separated.
# Include each one you use: LAN address, Tailscale name, and real domain.
# A missing origin here is the most common cause of "login does nothing".
TRUSTED_ORIGINS=http://localhost:8420,http://localhost:5173

# Set to true ONLY when the instance is reached over HTTPS.
# Secure cookies are never sent over plain HTTP, so setting this on a
# http://192.168.x.x deployment silently breaks login.
COOKIE_SECURE=false

AUTH_RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_MAX=60
