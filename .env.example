NODE_ENV=production
PORT=8420

DATABASE_URL=postgres://valence:valence@db:5432/valence

# Whether the server brings the database up to date when it starts.
#
# On by default, because updating should mean pulling the image and restarting.
# The alternative is a server that comes up against a schema a release behind,
# where a missing column breaks reads of one table and leaves the rest of the
# API answering normally — which reads as a bug in a screen rather than an
# update that has not landed.
#
# There is no rollback and no dump taken first, which is the reason to turn this
# off: an operator who wants to back up before a schema changes sets this to
# false, restarts, takes their copy, and then runs
#
#   docker compose exec valence node apps/server/dist/Migrate.js
#
# Migrations still ship in the image either way.
MIGRATE_ON_START=true

# Must be a randomly generated value of at least 32 characters.
# Generate with: openssl rand -base64 48
BETTER_AUTH_SECRET=change-me-to-a-random-value-at-least-32-chars

# The URL users actually reach this instance on.
#
# Passkeys derive their WebAuthn relying party id from this hostname, and a
# passkey only works on the hostname it was registered against. Changing this
# after users have enrolled passkeys invalidates them. Passkeys also require a
# secure context, so they are unavailable over plain HTTP on a LAN address.
BETTER_AUTH_URL=http://localhost:8420

# Every origin the web client is served from, comma separated.
# Include each one you use: LAN address, Tailscale name, and real domain.
# A missing origin here is the most common cause of "login does nothing".
#
# Sign-in and sign-out are rejected with 403 MISSING_OR_NULL_ORIGIN unless the
# browser's Origin header matches one of these. In development the client runs
# on :5173 and proxies to :8420, so both must be listed.
# Every address Valence is read at. A browser signing in from one that is not
# listed is refused.
#
# The addresses this machine holds are trusted without being listed, over
# either scheme, so this is for everything else: a domain, or whatever a
# reverse proxy answers as.
#
# The desktop client is trusted without being listed too, since it is not a
# page anybody can navigate to. Its dev server is an ordinary web address
# though, so add http://localhost:5174 to work on it.
TRUSTED_ORIGINS=http://localhost:8420,http://localhost:5173

# Set to true ONLY when the instance is reached over HTTPS.
# Secure cookies are never sent over plain HTTP, so setting this on a
# http://192.168.x.x deployment silently breaks login.
COOKIE_SECURE=false

AUTH_RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_MAX=60

# Key for the metadata catalogue a provider talks to.
#
# Empty by default: looking up what is in your library means telling a third
# party about it, which should be your decision rather than Valence's. Without a
# key, titles and years come from filenames alone.
CATALOGUE_API_KEY=

# Where fetched artwork is kept.
#
# Posters and backdrops are proxied through Valence and cached here, so a browser
# drawing your library never talks to the catalogue, and covers survive the
# catalogue reorganising its addresses.
IMAGE_CACHE_DIR=/cache/images

# Which clock scheduled jobs keep.
#
# A standard variable rather than one of Valence's, because it is how a container is told where it
# lives — and a container has no other way to know. Left unset, a container reports UTC however far
# from it you actually are, so "daily at 03:00" fires at 03:00 UTC rather than 3am where you are.
# A weekly trigger can land on the wrong day entirely.
#
# An IANA name, never an offset: Europe/London, not +01:00. A name follows daylight saving; an
# offset pins you to one side of it all year, which is the fault this setting exists to remove.
# A name with no daylight saving, like America/Phoenix or UTC, is fine and needs nothing special.
#
# A native install picks this up from the host and needs nothing here. The admin page shows which
# clock it settled on beside the times themselves, so a wrong one is visible rather than silent.
TZ=UTC

# Which graphics card the media service uses for VAAPI and QSV.
#
# Only read on Linux, where VAAPI and QuickSync are opened on a render node.
# NVENC and VideoToolbox find their own device and ignore this.
#
# The default is the first card. A machine with two has a renderD129 as well,
# and which one is Valence's to spend is not something to guess at — so it is
# asked for rather than detected, as Jellyfin does for the same reason.
#
# Getting this wrong is visible: the accelerator fails verification and the
# server falls back to encoding in software, which costs roughly two hundred
# times the processor time.
VALENCE_VAAPI_DEVICE=/dev/dri/renderD128

# Which FFmpeg the media service runs.
#
# Left unset, both fall back to whatever is first on PATH, which is how two
# developers on the same commit ended up on different major versions without
# either of them choosing one. The image installs Valence's own build and points
# these at it; set them locally to match, or to test a build before shipping it.
#
# Both, and not just the first: they are read independently, so setting only
# VALENCE_FFMPEG transcodes with one build while still probing with another.
# VALENCE_FFMPEG=/usr/lib/valence-ffmpeg/ffmpeg
# VALENCE_FFPROBE=/usr/lib/valence-ffmpeg/ffprobe

# On a Mac these matter more than they look, and the path above is not one a
# Mac has. VideoToolbox cannot be reached from inside a container, so a Mac
# serving Valence runs it natively and falls back to Homebrew's ffmpeg — which has
# no overlay_videotoolbox and no tonemap_videotoolbox, both being patches Valence's
# build carries. Measured through the media service's own probe, the difference
# is the whole hardware path:
#
#   Homebrew     hardwareOverlays: []   hardwareToneMaps: []
#   valence-ffmpeg  hardwareOverlays: [overlay_videotoolbox]
#                hardwareToneMaps: [tonemap_videotoolbox]
#
# With neither, burning in subtitles brings every frame down to system memory
# and back, bitmap subtitles give up the hardware entirely, and HDR converts on
# the processor. Nothing breaks — the probe reports what it found and the route
# is chosen from that — it is just far slower than the machine can manage.
#
# Take the macarm64 tarball from a valence-ffmpeg release and unpack it anywhere:
#
#   tar -xJf valence-ffmpeg_*_portable_macarm64-gpl.tar.xz -C ~/.local/lib/valence-ffmpeg
#
# VALENCE_FFMPEG=/Users/you/.local/lib/valence-ffmpeg/ffmpeg
# VALENCE_FFPROBE=/Users/you/.local/lib/valence-ffmpeg/ffprobe

# Where the media service listens, and where the server dials it.
#
# One setting for both ends, because a socket is bound and connected to by the
# same path: giving each half its own variable is what allows them to disagree.
#
# The container sets this to /run/valence-transcoder.sock itself and ignores what
# is here. This line is for running Valence outside a container, where /run is
# root owned and cannot be bound — hence a temporary path.
#
# An http:// address is used when the media service runs on another machine. In
# that case it is started separately, and TRANSCODER_URL tells it which
# interface to bind, since the host the server dials is not the one it binds.
TRANSCODER_URL=unix:/tmp/valence-transcoder.sock
